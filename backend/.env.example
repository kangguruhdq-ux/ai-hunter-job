# ==============================================
# JobHunter AI Environment Configuration Example
# ==============================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# AI Provider Configuration
# Options: 'gemini' or 'mock' (mock mode allows full local testing without an API key)
AI_PROVIDER=gemini

# Google Gemini API Settings (used when AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash

# Database Configuration
DATABASE_URL=sqlite:///./data/jobhunter.db

# Initial Administrator Provisioning
INITIAL_ADMIN_EMAIL=admin@jobhunter.ai
INITIAL_ADMIN_PASSWORD=AdminJobHunter2026!

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
