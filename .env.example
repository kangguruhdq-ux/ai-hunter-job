# ==============================================
# JobHunter AI Environment Configuration Example
# ==============================================
# NOTE: Never commit real API keys or secrets to Git.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# AI Provider Configuration
# Options: 'gemini' or 'mock' (mock mode allows full local testing without an API key)
AI_PROVIDER=mock

# Google Gemini API Settings (used when AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Database Configuration
# In Docker or PostgreSQL: postgresql://jobhunter:jobhunter_pass@localhost:5432/jobhunter_db
# For SQLite local dev: sqlite:///./data/jobhunter.db
DATABASE_URL=sqlite:///./data/jobhunter.db

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
